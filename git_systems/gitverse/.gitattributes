# GitVerse-specific text/binary normalization
# This file ensures consistent line endings across platforms

# Set default behavior to automatically normalize line endings
* text=auto

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf
*.cmd text eol=crlf

# Declare files that will always have LF line endings on checkout
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.ogg binary
*.flac binary
*.ttf binary
*.otf binary
*.eot binary
*.woff binary
*.woff2 binary